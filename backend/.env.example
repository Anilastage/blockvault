# Copy to .env and fill in real values.
NODE_ENV=development
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/blockvault
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d
CLIENT_URL=http://localhost:5173
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337
# Must match blockchain/deployment.json after `npm run deploy:local`
CONTRACT_ADDRESS=
BLOCKCHAIN_EXPLORER_URL=

# Email OTP — Resend (recommended; HTTPS API works on Render's free tier).
# Create a free key at https://resend.com/api-keys and paste it here.
# Without a verified domain, Resend only delivers to the account owner's email;
# for that case keep EMAIL_FROM_ADDRESS=onboarding@resend.dev.
RESEND_API_KEY=
EMAIL_FROM_NAME=BlockVault
EMAIL_FROM_ADDRESS=onboarding@resend.dev

# Email OTP — SMTP fallback (not usable on Render free tier: SMTP ports are blocked).
SMTP_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# SMS (Twilio) — optional, for SMS OTP two-factor authentication
# Leave blank to disable SMS OTP.
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=