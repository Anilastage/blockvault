# ----------------------------------------------------------------------------
# BlockVault — PRODUCTION backend environment template (git-committed).
#
# COPY THIS FILE TO backend/.env ON THE PRODUCTION HOST, fill in real values,
# and DO NOT COMMIT that file. These values feed the docker-compose stack via
# the shell environment / --env-file (docker-compose.yml reads the same names).
#
# For the containerized stack you can pass many of these via a git-ignored
# .env at the repo root (docker compose --env-file) instead of backend/.env.
# The backend/.env file is what `node dist/server.js` reads when you run the
# backend directly (non-Docker).
# ----------------------------------------------------------------------------

# --- Core ---
NODE_ENV=production
PORT=5000

# MongoDB. Prefer a managed instance with a least-privilege app user + backups.
# For Atlas:  mongodb+srv://app_user:*****@cluster0.abcde.mongodb.net/blockvault
# For compose's bundled mongo with auth:
#   mongodb://app_user:*****@mongo:27017/blockvault?authSource=admin
MONGODB_URI=

# --- Auth ---
# Generate one long random hex value per environment, e.g.:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# Never a known default — the backend refuses to start with a known default.
JWT_SECRET=
JWT_EXPIRES_IN=7d

# Comma-separated origins that the browser uses. MUST match the real origin or
# CORS will block requests. Example: https://app.yourdomain.com
CLIENT_URL=

# --- Blockchain (Sepolia deployment) ---
# Paste the address from blockchain/deployment.json after `npm run deploy:sepolia`.
BLOCKCHAIN_RPC_URL=
CHAIN_ID=11155111
CONTRACT_ADDRESS=
BLOCKCHAIN_EXPLORER_URL=

# --- Email (SMTP) — REQUIRED, login is gated on Email OTP ---
# Prefer a domain sender (SendGrid / SES / Zoho / Mailgun) over a free Gmail
# account (daily cap ~500 emails) and set SPF/DKIM/DMARC so OTPs don't hit spam.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM_NAME=BlockVault
EMAIL_FROM_ADDRESS=

# --- SMS (Twilio) — optional, only if you enable SMS OTP ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
