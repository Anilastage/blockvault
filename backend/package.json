{
  "name": "blockvault-backend",
  "version": "1.0.0",
  "private": true,
  "description": "BlockVault REST API server",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit && tsc -p tsconfig.test.json",
    "db": "node scripts/devDb.mjs",
    "test": "cross-env NODE_ENV=test mocha -r tsx 'test/**/*.test.ts' --timeout 120000 --exit"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "ethers": "^6.13.2",
    "express": "^4.19.2",
    "express-rate-limit": "^7.4.0",
    "helmet": "^7.1.0",
    "jsonwebtoken": "^9.0.2",
    "mongoose": "^8.5.3",
    "multer": "^2.2.0",
    "nodemailer": "^9.1.0",
    "otplib": "^13.5.0",
    "qrcode": "^1.5.4",
    "twilio": "^6.1.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/chai": "^4.3.17",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.6",
    "@types/mocha": "^10.0.10",
    "@types/multer": "^1.4.11",
    "@types/node": "^20.14.15",
    "@types/nodemailer": "^8.0.1",
    "@types/qrcode": "^1.5.6",
    "@types/supertest": "^6.0.2",
    "chai": "^4.4.1",
    "cross-env": "^7.0.3",
    "mocha": "^10.7.3",
    "mongodb-memory-server": "^11.2.0",
    "supertest": "^7.0.0",
    "tsx": "^4.17.0",
    "typescript": "^5.5.4"
  }
}
