# Copy to .env and fill in real values.

# Local / direct-API development:
#   VITE_API_URL=http://localhost:5000/api
#
# PRODUCTION (served behind the nginx reverse proxy in docker-compose):
# the frontend Dockerfile bakes in /api via the VITE_API_URL build ARG, so you
# do NOT need to set this file at all for the container. Only set an absolute
# URL here if the API lives on a DIFFERENT origin than the frontend.
VITE_API_URL=http://localhost:5000/api

# Optional: private key for the built-in demo wallet. Defaults to Hardhat's
# account #0 key (funded on the local node). Only for local development —
# never use a real account key here.
VITE_DEMO_WALLET_KEY=
