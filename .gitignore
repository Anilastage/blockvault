# Dependencies
node_modules/

# Secrets — never commit real environment files
.env
.env.*
!.env.example
# ...but DO commit the production/CI template files (they contain no real values)
!backend/.env.prod.example
!blockchain/.env.sepolia.example

# Build output
dist/
build/
*.tsbuildinfo
frontend/vite.config.js
frontend/vite.config.d.ts

# Hardhat / Solidity artifacts (regenerated by `npm run compile`)
blockchain/artifacts/
blockchain/cache/
blockchain/typechain-types/
blockchain/deployment.json

# Backend runtime data
backend/.data/
.data/
backend/uploads/*
!backend/uploads/.gitkeep

# Logs & misc
*.log
.DS_Store
Thumbs.db