# ----------------------------------------------------------------------------
# BlockVault — DOCKER COMPOSE environment (git-committed template).
#
# COPY THIS FILE TO .env ON THE PRODUCTION HOST (alongside docker-compose.yml),
# fill in real values, and DO NOT COMMIT that file (.env is git-ignored).
#
# docker-compose.yml reads these via Compose variable substitution. You can
# either:
#   (a) export them in the shell before `docker compose up -d`, or
#   (b) run with an explicit env file:
#         docker compose --env-file .env up -d --build
#
# Required vars have no default and Compose will refuse to start the stack if
# they are missing. This deliberately prevents the old
# `change-me-to-a-long-random-string` fallback from ever reaching production.
# ----------------------------------------------------------------------------

# --- Required (Compose fails fast if unset) ---
# Comma-separated browser origins, must match the live origin, e.g.
#   CLIENT_URL=https://app.yourdomain.com
CLIENT_URL=

# Long random hex, e.g. `node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"`
JWT_SECRET=

# Sepolia provider endpoint, e.g. https://eth-sepolia.g.alchemy.com/v2/<key>
BLOCKCHAIN_RPC_URL=

# Must be 11155111 for Sepolia.
CHAIN_ID=11155111

# --- Optional / defaulted ---
# Point MONGODB_URI at a managed DB. Defaults to the bundled `mongo` service.
# MONGODB_URI=mongodb://mongo:27017/blockvault
# JWT_EXPIRES_IN=7d
# CONTRACT_ADDRESS=
# BLOCKCHAIN_EXPLORER_URL=
#
# Resend (email OTP — recommended; HTTPS API works anywhere).
# RESEND_API_KEY=
# EMAIL_FROM_NAME=BlockVault
# EMAIL_FROM_ADDRESS=onboarding@resend.dev
#
# SMTP fallback (blocked on Render's free tier).
# SMTP_ENABLED=false
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
#
# Twilio (optional SMS OTP)
# TWILIO_ACCOUNT_SID=
# TWILIO_AUTH_TOKEN=
# TWILIO_FROM_NUMBER=
