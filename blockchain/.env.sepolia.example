# ----------------------------------------------------------------------------
# BlockVault — Sepolia deployment environment (git-committed template).
#
# COPY THIS FILE TO blockchain/.env ON THE PRODUCTION HOST, fill in real
# values, and DO NOT COMMIT that file. blockchain/.env is git-ignored.
# These values are read by blockchain/hardhat.config.ts for `npm run deploy:sepolia`.
#
#   - SEPOLIA_RPC_URL   : Infura / Alchemy free tier endpoint for Sepolia.
#   - DEPLOYER_PRIVATE_KEY : private key of a FUNDED testnet wallet (needs Sepolia ETH).
#   - ETHERSCAN_API_KEY : optional — set to auto-verify the contract on Etherscan.
# ----------------------------------------------------------------------------

# Alchemy free tier   : https://eth-sepolia.g.alchemy.com/v2/<key>
# Infura             : https://sepolia.infura.io/v3/<project-id>
# Public RPC          : https://rpc.sepolia.org  (rate-limited, not recommended for deploys)
SEPOLIA_RPC_URL=

# Private key WITHOUT the leading 0x is also fine; keep it out of git.
# Get Sepolia ETH from a faucet (e.g. sepoliafaucet.com / Alchemy faucet).
DEPLOYER_PRIVATE_KEY=

# Optional, for `hardhat verify`.
ETHERSCAN_API_KEY=

# --- WARNING from hardhat.config.ts -----------------------------------------
# If SEPOLIA_RPC_URL or DEPLOYER_PRIVATE_KEY are missing, the Sepolia network
# entry is created with an empty URL / no accounts and deployments will fail
# with a clear error rather than silently using a default.
